---
import StackChips from "./StackChips.astro";
import { projects } from "../data/projects";

const [featured, ...rest] = projects;
---

<section id="proyectos" class="mx-auto max-w-6xl scroll-mt-16 px-5 py-20 sm:px-8 md:py-28">
  <h2 class="headline text-[clamp(2.25rem,5vw,3.5rem)]">Lo que he construido</h2>
  <div class="mt-4 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
    <p class="max-w-[60ch] text-lg text-muted">
      Productos que diseñé y programé de principio a fin. Abre cada uno para ver sus logros y las tecnologías
      que usa.
    </p>
    <button type="button" class="link cursor-pointer text-sm text-muted hover:text-ink" data-fold-all>
      Abrir todos
    </button>
  </div>

  {
    featured && (
      <article
        id={featured.slug}
        data-project
        data-stack={featured.stack.join("|")}
        class="project mt-12 overflow-hidden rounded-2xl border border-line bg-surface"
      >
        {featured.images && featured.images.length > 0 && (
          <div class="relative bg-[#e9eeec] px-5 pt-6 sm:px-10 sm:pt-10 dark:bg-[#1b2433]">
            <img
              src={featured.images[0]!.src}
              alt={featured.images[0]!.alt}
              width={featured.images[0]!.width}
              height={featured.images[0]!.height}
              loading="eager"
              class="w-full rounded-t-lg shadow-[0_-1px_0_rgb(0_0_0/0.04),0_10px_30px_-12px_rgb(14_22_48/0.35)] md:w-[78%]"
            />
            {featured.images[1] && (
              <img
                src={featured.images[1].src}
                alt={featured.images[1].alt}
                width={featured.images[1].width}
                height={featured.images[1].height}
                loading="lazy"
                class="absolute right-6 bottom-6 hidden w-[27%] rounded-lg shadow-[0_18px_40px_-14px_rgb(14_22_48/0.5)] md:block lg:right-10"
              />
            )}
          </div>
        )}

        <div class="p-6 sm:p-10">
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
            <span class="inline-flex items-center gap-1.5 font-medium text-approved">
              <span class="size-2 rounded-full bg-approved" aria-hidden="true" />
              En producción
            </span>
            <span>{featured.kind}, {featured.period}</span>
          </p>
          <h3 class="headline mt-3 text-[clamp(2rem,4vw,2.75rem)]">{featured.name}</h3>
          <p class="mt-3 max-w-[62ch] text-lg">{featured.tagline}</p>
          {featured.proof && <p class="mt-3 max-w-[62ch] text-muted">{featured.proof}</p>}
          {featured.links && featured.links.length > 0 && (
            <p class="mt-6 flex flex-wrap gap-3">
              {featured.links.map((l, i) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                  class={`btn ${i === 0 ? "bg-ultra text-on-ultra hover:bg-ultra-deep dark:text-ultra-deep dark:hover:bg-on-ultra" : "border border-line hover:border-ultra"}`}
                >
                  {l.label}
                  <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M8 4H4v12h12v-4M11 3h6v6M17 3l-8 8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
              ))}
            </p>
          )}

          <details class="fold mt-7">
            <summary class="fold-toggle">
              <span class="when-closed">Ver logros y tecnologías</span>
              <span class="when-open">Ocultar detalles</span>
              <svg class="chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m5 8 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="grid gap-10 pt-7 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-16">
              <ul class="space-y-3">
                {featured.highlights.map((h) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.65em] size-1.5 shrink-0 rounded-full bg-ultra" aria-hidden="true" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <StackChips stack={featured.stack} source={`projects.ts → ${featured.slug}`} />
            </div>
          </details>
        </div>
      </article>
    )
  }

  <div class="mt-6 grid gap-6 lg:grid-cols-2 lg:items-start">
    {
      rest.map((project, i) => (
        <article
          id={project.slug}
          data-project
          data-stack={project.stack.join("|")}
          class={`project flex flex-col rounded-2xl border border-line bg-surface p-6 sm:p-8 ${
            rest.length % 2 === 1 && i === rest.length - 1 ? "lg:col-span-2" : ""
          }`}
        >
          {project.images && project.images.length > 0 && (
            <div class="relative -mx-6 -mt-6 mb-7 overflow-hidden rounded-t-2xl bg-[#e9eeec] px-5 pt-5 sm:-mx-8 sm:-mt-8 sm:px-8 sm:pt-8 dark:bg-[#1b2433]">
              <img
                src={project.images[0]!.src}
                alt={project.images[0]!.alt}
                width={project.images[0]!.width}
                height={project.images[0]!.height}
                loading="lazy"
                class="w-full rounded-t-lg shadow-[0_10px_30px_-12px_rgb(14_22_48/0.35)] sm:w-[80%]"
              />
              {project.images[1] && (
                <img
                  src={project.images[1].src}
                  alt={project.images[1].alt}
                  width={project.images[1].width}
                  height={project.images[1].height}
                  loading="lazy"
                  class="absolute right-5 bottom-0 hidden w-[30%] rounded-t-lg shadow-[0_18px_40px_-14px_rgb(14_22_48/0.5)] sm:right-8 sm:block"
                />
              )}
            </div>
          )}
          <p class="text-sm text-muted">
            {project.kind}, {project.period}
          </p>
          <h3 class="headline mt-2 text-[1.875rem]">{project.name}</h3>
          <p class="mt-3">{project.tagline}</p>
          {project.proof && <p class="mt-2 text-sm text-approved">{project.proof}</p>}
          {project.links && project.links.length > 0 && (
            <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-ultra">
              {project.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener" class="link inline-flex items-center gap-1">
                  {l.label}
                  <svg class="size-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M8 4H4v12h12v-4M11 3h6v6M17 3l-8 8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
              ))}
            </p>
          )}

          <details class="fold mt-auto pt-6">
            <summary class="fold-toggle">
              <span class="when-closed">Ver logros y tecnologías</span>
              <span class="when-open">Ocultar detalles</span>
              <svg class="chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m5 8 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <ul class="mt-5 space-y-2 text-[0.9375rem] text-muted">
              {project.highlights.map((h) => (
                <li class="flex gap-3">
                  <span class="mt-[0.65em] size-1.5 shrink-0 rounded-full bg-ultra" aria-hidden="true" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <div class="pt-7">
              <StackChips stack={project.stack} source={`projects.ts → ${project.slug}`} />
            </div>
          </details>
        </article>
      ))
    }
  </div>
</section>

<script>
  const folds = [...document.querySelectorAll<HTMLDetailsElement>("#proyectos details.fold")];
  const all = document.querySelector<HTMLButtonElement>("[data-fold-all]")!;
  const sync = () => (all.textContent = folds.every((f) => f.open) ? "Plegar todos" : "Abrir todos");
  all.addEventListener("click", () => {
    const open = !folds.every((f) => f.open);
    for (const f of folds) f.open = open;
    sync();
  });
  for (const f of folds) f.addEventListener("toggle", sync);
</script>

<style>
  .fold-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.4rem 0.6rem 0.4rem 0.95rem;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--ultra);
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .fold-toggle::-webkit-details-marker {
    display: none;
  }

  .fold-toggle:hover {
    border-color: var(--ultra);
  }

  .chevron {
    width: 1.1rem;
    height: 1.1rem;
    transition: rotate 200ms ease;
  }

  .fold[open] .chevron {
    rotate: 180deg;
  }

  .fold[open] .when-closed,
  .fold:not([open]) .when-open {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }

  .project {
    transition:
      opacity 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  /* Cuando en Skills eliges una tecnología, los proyectos que no la usan se apagan. */
  :global(body[data-filter]) .project:not([data-match]) {
    opacity: 0.35;
  }

  :global(body[data-filter]) .project[data-match] {
    border-color: var(--ultra);
    box-shadow: 0 0 0 1px var(--ultra);
  }

  :global(.chip[data-active]) {
    border-color: var(--ultra);
    background: var(--ultra);
    color: var(--on-ultra);
  }
</style>
