---
import { profile } from "../data/profile";

const links = [
  { href: "#proyectos", label: "Proyectos" },
  { href: "#skills", label: "Skills" },
  { href: "#experiencia", label: "Experiencia" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="on-ultra sticky top-0 z-40 bg-ultra-deep text-on-ultra">
  <nav aria-label="Secciones" class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a href="#inicio" class="hidden text-sm font-semibold sm:block">{profile.name}</a>
    <div class="flex items-center gap-3 sm:gap-7">
    <ul class="flex items-center gap-3.5 text-sm sm:gap-7">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-on-ultra-muted transition-colors hover:text-on-ultra">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      data-theme-toggle
      class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-full border border-on-ultra/25 text-on-ultra transition-colors hover:border-on-ultra/60 hover:bg-on-ultra/10"
      aria-label="Cambiar a modo oscuro"
    >
      <svg class="size-[1.1rem] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 14.1A8.5 8.5 0 1 1 9.9 3.5a6.6 6.6 0 0 0 10.6 10.6Z" />
      </svg>
      <svg class="hidden size-[1.1rem] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
    </button>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
  const label = () =>
    toggle.setAttribute("aria-label", root.dataset.theme === "dark" ? "Cambiar a modo claro" : "Cambiar a modo oscuro");

  toggle.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    label();
  });

  // Si el visitante nunca eligió, el sitio sigue al sistema cuando este cambia.
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    let saved = null;
    try {
      saved = localStorage.getItem("theme");
    } catch {}
    if (saved) return;
    root.dataset.theme = e.matches ? "dark" : "light";
    label();
  });

  label();
</script>
